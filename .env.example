POSTGRES_USER=er
POSTGRES_PASSWORD=er_password
POSTGRES_DB=entity_resolution
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------- production
# Used on Render (free tier). Redis: Upstash free RESP URL (rediss://...).
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname?sslmode=require
REDIS_URL=rediss://default:CHANGE_ME@your-upstash-host.upstash.io:6379
CELERY_BROKER_URL=rediss://default:CHANGE_ME@your-upstash-host.upstash.io:6379/1
CELERY_RESULT_BACKEND=rediss://default:CHANGE_ME@your-upstash-host.upstash.io:6379/2
CORS_ORIGINS=["https://YOUR_VERCEL_APP.vercel.app","http://localhost:5173","http://127.0.0.1:5173"]
JWT_SECRET_KEY=generate-a-long-random-hex-string-here
AUTO_SEED_ON_STARTUP=false
RUN_MIGRATIONS_ON_STARTUP=true
