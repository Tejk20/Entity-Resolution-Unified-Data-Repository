# ---------------------------------------------------------------------------
# Local development WITHOUT Docker.
#
# Copy to .env (repo root) or backend/.env, then run Postgres and Redis
# natively:
#   Postgres:  https://www.postgresql.org/download/windows/
#              createuser --createdb --pwprompt er   (password er_password)
#              createdb -O er entity_resolution
#   Redis:     https://github.com/microsoftarchive/redis/releases
#              (redis-server.exe) --appendonly yes
#
# Then:
#   backend : cd backend && python scripts/start.py --reload
#   frontend: cd frontend && npm install && npm run dev
#
# Only the API reads this file; VITE_API_BASE_URL is here as a reminder that the
# frontend has its own copy in frontend/.env.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://er:er_password@localhost:5432/entity_resolution
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
UPLOAD_DIR=data/uploads
LOG_LEVEL=INFO

# Demo datasets on first boot (dispatches Celery tasks, so the worker must be up).
AUTO_SEED_ON_STARTUP=true
RUN_MIGRATIONS_ON_STARTUP=true
JWT_SECRET_KEY=dev-only-secret-change-me

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173"]

VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# PRODUCTION (Render). Set these in the Render dashboard instead of a file --
# render.yaml declares the same keys with the managed Postgres/Redis wiring.
#   DATABASE_URL        -> render.yaml fromDatabase (do not paste by hand)
#   REDIS_URL /
#   CELERY_BROKER_URL /
#   CELERY_RESULT_BACKEND -> all three point at the same Key Value instance
#   CORS_ORIGINS        -> your Vercel origin, e.g. ["https://my-app.vercel.app"]
#   JWT_SECRET_KEY      -> render.yaml generateValue: true
#   UPLOAD_DIR=/tmp/er-uploads -> the free tier disk is ephemeral
# ---------------------------------------------------------------------------
